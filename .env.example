# Hospital Flow AI Environment Configuration

# LLM Provider Switch: mock (default), gemini, openai
LLM_PROVIDER=mock

# Optional External API Keys (Leave blank to use built-in deterministic engine)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Database Configuration
POSTGRES_DB=hospitalflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword

# Application Ports
BACKEND_PORT=8080
AI_SERVICE_PORT=8000
FRONTEND_PORT=5173
